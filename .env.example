# Application Settings
APP_NAME="SYB Business Management System"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/BMS
APP_TIMEZONE=Asia/Manila

# Database Configuration (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=business_management_system
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4

# Session & Security Settings
SESSION_NAME=SYB_BMS_SESSION
SESSION_LIFETIME=3600
SESSION_ABSOLUTE_LIFETIME=28800
# auto = enabled automatically over HTTPS, disabled over local HTTP; set true in production HTTPS
SESSION_SECURE_COOKIE=auto

# Document Storage Settings
MAX_UPLOAD_SIZE_MB=10

